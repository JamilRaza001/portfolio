# Google Stitch MCP — design generation (Phase 2)
# Get a key: https://stitch.withgoogle.com -> profile picture -> Stitch settings -> API key -> Create key
STITCH_API_KEY=

# Context7 MCP — library docs. Optional: works anonymously, a key only raises rate limits.
# CONTEXT7_API_KEY=

# Portfolio appearance. Restart development / rebuild after changing.
# black-studio | blue-amber | charcoal-copper | olive-champagne | aubergine-silver
PUBLIC_SITE_THEME=black-studio
# Optional custom origin. Vercel's production domain is detected automatically.
PUBLIC_SITE_URL=
# Defaults to the owner-supplied CV in site.config.ts.
PUBLIC_RESUME_PATH=/resumes/muhammad-jamil-raza-resume.pdf
