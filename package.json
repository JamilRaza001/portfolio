{
  "name": "jamil-raza-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "typecheck": "node scripts/astro.mjs check",
    "test": "node --test tests/*.test.ts",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm run test && npm run typecheck && npm run build && npm run verify:build"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "astro": "7.3.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.13.4",
    "typescript": "~5.9.3"
  }
}
