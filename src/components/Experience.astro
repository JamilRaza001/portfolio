        <div class="career-story"><div class="career-employer"><p class="career-company">{role.company}</p><span>{role.suffix}</span><h3 id={`career-heading-${role.id}`}>{role.role}</h3><p class="career-domains">{role.contribution}</p></div><div class="career-contribution"><h4>{role.focus}</h4><p>{role.text}</p><p class="career-evidence">{role.evidence}</p><a class="simple-link" href={role.link}>{role.linkText} <span aria-hidden="true">↗</span></a></div></div>
