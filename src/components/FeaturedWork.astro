---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';
const selected = projects.filter(project => project.featured);
---
<section class="work-story wrap" id="work" aria-labelledby="work-title">
  <div class="work-anchor"><p class="section-label">Selected Work</p><h2 id="work-title">Built for Real Life.</h2><p>Voice, knowledge and operations. Three different problems, explored through the systems behind them.</p><nav class="work-chapters" aria-label="Featured projects">{selected.map((project,index) => <a href={`#featured-${project.slug}`}><span>{String(index+1).padStart(2,'0')}</span>{project.title}</a>)}</nav><a class="simple-link" href="/projects/">All projects <span aria-hidden="true">↗</span></a><div class="work-progress" aria-hidden="true"><span></span></div></div>
  <div class="work-stack">{selected.map((project,index) => <div class="work-scene" id={`featured-${project.slug}`} data-work-scene style={`--scene-index:${index}`}><ProjectCard project={project} /></div>)}</div>
</section>
