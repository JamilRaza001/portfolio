---
import type { Project } from '../data/projects';
import ProjectArtwork from './ProjectArtwork.astro';
interface Props { project: Project; wide?: boolean; }
const { project, wide = false } = Astro.props;
---
<article class:list={['project-card', { 'project-wide': wide }]} data-category={project.category}>
  <a class="project-art-link" href={`/projects/${project.slug}/`} aria-label={`View ${project.title} case study`} tabindex="-1"><ProjectArtwork slug={project.slug} title={project.title} /></a>
  <div class="project-card-copy"><div class="project-meta"><span>{project.category}</span><span>{project.status}</span></div><h3><a href={`/projects/${project.slug}/`}>{project.title}<span aria-hidden="true">↗</span></a></h3><p>{project.summary}</p><div class="project-card-bottom"><span>{project.visibility === 'private' ? 'Private source · Public case study' : 'Public repository'}</span><a href={`/projects/${project.slug}/`}>View project<span class="sr-only">: {project.title}</span></a></div></div>
</article>
