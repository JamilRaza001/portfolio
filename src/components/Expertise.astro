---
const skills = [
  { name: 'AI, Software & ML Engineering', title: 'From models to useful applications.', description: 'I bring AI, machine learning and software engineering together: RAG, agentic workflows, voice systems and computer vision, connected through APIs, streaming and application logic.', tools: ['Python', 'LangGraph', 'LangChain', 'FastAPI', 'PyTorch', 'OpenCV', 'pgvector', 'Docker'], proofLabel: 'AI application case study', project: 'AlphaLens', href: '/projects/alphalens/', note: 'Hybrid retrieval and cited synthesis over financial filings. In progress.' },
  { name: 'Multi-cloud Data Engineering', title: 'Reliable data, from source to application.', description: 'I work with AWS and Azure alongside Python and SQL. My data engineering work covers ingestion, ETL, validation and database integration, connecting source records and external APIs to the applications that use them.', tools: ['AWS', 'Azure', 'Python', 'SQL', 'ETL / ELT', 'Pandas', 'PostgreSQL', 'Docker'], proofLabel: 'Data pipeline case study', project: 'Qurbani Analytics', href: '/projects/qurbani-analytics/', note: 'Python ETL, deduplication and calendar alignment across three years of records.' },
  { name: 'Data Science & Analytics', title: 'Understand the data. Support the decision.', description: 'I clean and explore data, engineer features, compare ML approaches and build dashboards. The work spans sensor and satellite analysis, operational reporting and visual explanations for non-technical teams.', tools: ['Pandas', 'NumPy', 'scikit-learn', 'XGBoost', 'Plotly', 'Streamlit'], proofLabel: 'Data science case study', project: 'CropLogic', href: '/projects/croplogic/', note: 'Sensor and imagery preprocessing with model comparison in an Omdena collaboration.' },
];
---
<section class="skills-section wrap" id="expertise" aria-labelledby="skills-title">
  <div class="skills-heading"><p class="section-label">What I work with</p><h2 id="skills-title">Pick a discipline.<br />See the thinking.</h2></div>
  <div class="skills-browser" data-panel-group="skills">
    <div class="skills-tabs" data-panel-tabs aria-label="Choose an engineering discipline" hidden>{skills.map((skill,index) => <button type="button" data-panel-choice={index} id={`skills-tab-${index}`}><span>{skill.name}</span><span aria-hidden="true">↗</span></button>)}</div>
    <div class="skills-stage" data-panel-stage>{skills.map((skill,index) => <article class="skill-panel" data-panel={index} id={`skills-panel-${index}`} aria-labelledby={`skill-title-${index}`}><p class="skill-domain">{skill.name}</p><h3 id={`skill-title-${index}`}>{skill.title}</h3><p class="skill-description">{skill.description}</p><ul class="skill-tools" aria-label={`${skill.name} tools`}>{skill.tools.map(tool => <li>{tool}</li>)}</ul><a class="skill-proof" href={skill.href}><span><small>{skill.proofLabel}</small><strong>{skill.project}</strong><span>{skill.note}</span></span><span aria-hidden="true">↗</span></a></article>)}</div>
  </div>
</section>
