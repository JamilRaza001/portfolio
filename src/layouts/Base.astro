---
import '@fontsource/atkinson-hyperlegible/latin-400';
import '@fontsource/atkinson-hyperlegible/latin-700';
import '../styles/global.css';
import '../styles/refinement.css';
import '../styles/experience.css';
import '../styles/studio.css';
import '../styles/navigation.css';
import { getSettings, identity } from '../lib/config';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = 'AI, ML & Data Engineer — Muhammad Jamil Raza', description = 'Muhammad Jamil Raza builds AI and ML applications, software, data pipelines and analytics, with AWS and Azure experience. Explore projects and engineering case studies.' } = Astro.props;
const settings = getSettings(import.meta.env);
const noindex = Astro.props.noindex || !settings.indexable;
const tokens = Object.entries(settings.palette).filter(([key]) => key !== 'name').map(([key, value]) => `--${key}:${value}`).join(';');
const canonical = settings.origin && settings.indexable && !Astro.props.noindex ? new URL(Astro.url.pathname, settings.origin).href : undefined;
const workActive = Astro.url.pathname.startsWith('/projects');
const jsonld = { '@context': 'https://schema.org', '@type': 'Person', name: identity.fullName, jobTitle: 'AI Engineer', url: settings.origin, sameAs: [identity.github, identity.linkedin] };
---
<!doctype html>
<html lang="en" data-theme={settings.theme} style={tokens}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={settings.palette.bg} />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="author" content={identity.fullName} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Muhammad Jamil Raza" />
    {canonical && <meta property="og:url" content={canonical} />}
    {settings.origin && <><meta property="og:image" content={`${settings.origin}/social.png`} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Muhammad Jamil Raza — Intelligent systems. Real-world purpose." /></>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {settings.origin && <meta name="twitter:image" content={`${settings.origin}/social.png`} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonld).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href="/" aria-label="Muhammad Jamil Raza — home"><span class="brand-mark">mjr<span>.</span></span></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Open navigation" hidden><span data-menu-label>Menu</span><span class="menu-icon" aria-hidden="true"><span></span><span></span></span></button>
      <div class="site-menu" id="site-menu">
        <nav aria-label="Main navigation">
          <a href="/projects/" aria-current={workActive ? 'page' : undefined}>Work</a>
          <a href="/#expertise">Expertise</a>
          <a href="/#about">About</a>
          <a href="#contact">Contact</a>
        </nav>
        <a class="resume-link" href={settings.resume || identity.resumeRequest} download={settings.resume ? 'Muhammad-Jamil-Raza-Resume.pdf' : undefined}>{settings.resume ? 'Download résumé' : 'Request résumé'}<span aria-hidden="true">{settings.resume ? '↓' : '↗'}</span></a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer id="contact" class="contact wrap">
      <div class="contact-heading"><p class="section-label">A Good Place to Start</p><h2>What Shall We Build Next?</h2></div>
      <div class="contact-details"><div class="contact-intents" aria-label="Choose a conversation" hidden><button type="button" data-contact-intent="project" aria-pressed="false">A project</button><button type="button" data-contact-intent="role" aria-pressed="false">An opportunity</button><button type="button" data-contact-intent="hello" aria-pressed="false">Just say hello</button></div><p data-intent-copy aria-live="polite">Building an AI application, connecting data pipelines, or turning data into decisions? Tell me about your project, engineering role or analytics challenge.</p><a class="email-link" href={`mailto:${identity.email}`}>{identity.email}<span aria-hidden="true"> ↗</span></a><p class="contact-availability">Based in Karachi. Open to remote roles, project collaborations and relocation.</p><div class="contact-actions"><button class="text-button" data-copy-email={identity.email} hidden>Copy email</button><span class="copy-status" role="status" aria-live="polite"></span></div></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Muhammad Jamil Raza</span><span>Karachi, Pakistan</span><div><a href={identity.github}>GitHub ↗</a><a href={identity.linkedin}>LinkedIn ↗</a><a href={settings.resume || identity.resumeRequest} download={settings.resume ? 'Muhammad-Jamil-Raza-Resume.pdf' : undefined}>{settings.resume ? 'Download résumé ↓' : 'Request résumé ↗'}</a></div></div>
    </footer>
    <script>
      import '../scripts/navigation';
      import '../scripts/motion';
      import '../scripts/interactions';
      import '../scripts/studio-motion';
      const copy = document.querySelector<HTMLButtonElement>('[data-copy-email]');
      if (copy && navigator.clipboard) {
        copy.hidden = false;
        copy.addEventListener('click', async () => {
          const status = document.querySelector<HTMLElement>('.copy-status');
          try { await navigator.clipboard.writeText(copy.dataset.copyEmail || ''); if (status) status.textContent = 'Email copied.'; }
          catch { if (status) status.textContent = 'Please use the email link above.'; }
        });
      }
    </script>
  </body>
</html>
