---
import Base from '../layouts/Base.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import Expertise from '../components/Expertise.astro';
import Experience from '../components/Experience.astro';
import ProfessionalBackground from '../components/ProfessionalBackground.astro';
import { identity } from '../lib/config';
const portrait = 'jamil-studio-portrait-v2';

---
<Base>
  <section class="hero hero-personal wrap" aria-labelledby="intro-title">
    <div class="hero-intro">
      <p class="hero-greeting">Hello, I’m</p>
      <h1 id="intro-title"><span>Muhammad</span> <span>Jamil Raza.</span></h1>
      <p class="hero-profession">Engineer. Builder. Educator. <span>AI, Software & ML Engineer</span> <span>Multi-Cloud Data Engineering · AWS & Azure</span> <span>Data Science & Analytics</span></p>
      <p class="hero-description">I build AI applications, data pipelines and analytics tools that turn conversations, documents and operational data into useful systems.</p>
      <div class="hero-actions"><a class="button" href="/projects/">Explore my work <span aria-hidden="true">↗</span></a><a class="simple-link" href={identity.linkedin} target="_blank" rel="noopener noreferrer">Let’s connect <span class="sr-only">on LinkedIn (opens in a new tab)</span><span aria-hidden="true">↗</span></a></div>
      <p class="hero-note">Open to remote opportunities and relocation.</p>
    </div>
    <figure class="hero-portrait">
      <div class="portrait-frame"><img src={`/images/${portrait}-960.webp`} srcset={`/images/${portrait}-480.webp 480w, /images/${portrait}-960.webp 960w`} sizes="(max-width: 520px) 90vw, (max-width: 800px) 520px, (max-width: 1440px) 40vw, 520px" width="960" height="1200" alt="Muhammad Jamil Raza in a charcoal blazer and ivory shirt against a dark studio backdrop" fetchpriority="high" /></div>
      <figcaption>Muhammad Jamil Raza</figcaption>
    </figure>
    <div class="hero-foot"><span>Real work. Thoughtful engineering.</span><a href="#work">Discover the work <span aria-hidden="true">↓</span></a></div>
  </section>
  <ProfessionalBackground />
  <FeaturedWork />
  <Expertise />
  <Experience />
  <section id="about" class="about-story wrap" aria-labelledby="about-title">
    <p class="section-label">The Person Behind the Work</p>
    <h2 id="about-title" class="about-statement"><span>Curious About AI.</span> <span>Serious About</span> <span>Making It Useful.</span></h2>
    <div class="about-bottom"><div class="about-person"><img src={`/images/${portrait}-480.webp`} width="88" height="110" loading="lazy" alt="Muhammad Jamil Raza Attari" /><div><strong>Muhammad Jamil Raza Attari</strong><span>AI Engineer & Educator</span><span>Karachi, Pakistan</span></div></div><div class="about-narrative"><p>At Saylani, I build AI applications and the data pipelines around them: voice interactions, document retrieval, workflow automation and operational reporting. My work connects Python and SQL with APIs, models and the people using the results.</p><p>At SMIT, I teach Python, machine learning, data analysis and agentic AI through practical projects, helping aspiring engineers move from foundations to deployment. With Omdena’s CropLogic team, I contribute to agricultural ML using sensor and satellite data.</p><details class="education-disclosure"><summary>Education & Continuous Learning <span aria-hidden="true">+</span></summary><p>Bachelor’s in Software Engineering, Virtual University</p><p>AI & Data Science — SMIT, September 2025<br />Agentic AI — SMIT, May 2026</p><p>Deloitte Australia — Data Analytics Job Simulation<br />Omdena AI Innovation Challenge — CropLogic</p></details><a class="simple-link" href="https://www.linkedin.com/in/jamilrazaa/">My professional background <span aria-hidden="true">↗</span></a></div></div>
  </section>
</Base>
