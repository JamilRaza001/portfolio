---
import Base from '../../layouts/Base.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Demo from '../../components/Demo.astro';
import { projects, type Project } from '../../data/projects';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
interface Props { project: Project; }
const { project } = Astro.props;
const related = projects.filter(p => project.related.includes(p.slug)).slice(0, 2);
---
<Base title={`${project.title} — Muhammad Jamil Raza`} description={project.summary}>
  <article class="case-study wrap">
    <div class="case-intro"><a class="breadcrumb" href="/projects/">← All projects</a><div class="case-topline"><span>{project.category}</span><span class="status-badge">{project.status}</span></div><h1>{project.title}</h1><p class="case-summary">{project.summary}</p><div class="case-facts"><div><span>Context</span><p>{project.organization}</p></div><div><span>Source access</span><p>{project.visibility === 'private' ? 'Private repository' : 'Public repository'}</p></div><div><span>My contribution</span><p>{project.role}</p></div></div></div>
    <div class="case-cover"><ProjectArtwork slug={project.slug} title={project.title} eager /><div class="case-cover-caption"><strong>{project.lead}</strong><span>{project.leadLabel}</span></div></div>
    <div class="case-content"><aside class="case-nav"><span>In this case study</span><a href="#problem">The problem</a><a href="#solution">The solution</a><a href="#architecture">System architecture</a><a href="#decisions">Engineering decisions</a><a href="#outcomes">Outcomes & evidence</a><a href="#limitations">Limitations</a>{project.demo && <a href="#walkthrough">Sample walkthrough</a>}</aside><div class="case-prose">
      <section id="problem"><p class="section-label">The Problem</p><h2>Where the Work Began.</h2><p>{project.problem}</p></section>
      <section id="solution"><p class="section-label">The Solution</p><h2>A System Built Around It.</h2><p>{project.solution}</p>{project.stack.length > 0 && <ul class="tag-list">{project.stack.map(tool => <li>{tool}</li>)}</ul>}</section>
      <section id="architecture"><p class="section-label">System Architecture</p><h2>How the Pieces Connect.</h2><p class="small-muted">An original, simplified diagram. No internal interface or customer data is shown.</p><ol class="architecture-flow">{project.architecture.map((step, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><strong>{step}</strong></li>)}</ol></section>
      <section id="decisions"><p class="section-label">Engineering Decisions</p><h2>The Thinking Behind the System.</h2><div class="decision-list">{project.decisions.map(item => <div><h3>{item.title}</h3><p>{item.body}</p></div>)}</div></section>
      <section id="outcomes"><p class="section-label">Outcomes & Evidence</p><h2>What I Can Stand Behind.</h2><ul class="prose-list">{project.outcomes.map(item => <li>{item}</li>)}</ul></section>
      <section id="limitations"><p class="section-label">Limitations</p><h2>Where the Boundary Is.</h2><ul class="prose-list">{project.limitations.map(item => <li>{item}</li>)}</ul>{project.visibility === 'public' && project.repo ? <a class="button button-quiet" href={project.repo}>View public repository ↗</a> : <p class="private-note">Source code is private. This case study shares the engineering story without disclosing internal implementation.</p>}</section>
    </div></div>
    {project.demo && <div id="walkthrough"><Demo type={project.demo} /></div>}
    {related.length > 0 && <section class="related-work"><div class="section-heading"><div><p class="section-label">Keep Exploring</p><h2>Another Side of the Work.</h2></div><a class="simple-link" href="/projects/">All projects ↗</a></div><div class="all-projects">{related.map(item => <ProjectCard project={item} />)}</div></section>}
  </article>
</Base>
